// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch:ext",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "-lic",
        "pnpm run watch:ext"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": [
        {
          "base": "$tsc",
          "applyTo": "closedDocuments",
          "fileLocation": "absolute",
          "severity": "error",
          "background": {
            "activeOnStart": false,
            "beginsPattern": "dist/server\\.js",
            "endsPattern": "Rebuilt in \\d+ms\\."
          }
        }
      ],
      "group": "build"
    }
  ]
}
